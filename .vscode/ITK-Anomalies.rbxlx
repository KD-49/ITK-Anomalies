	addStroke(resultFrame, Color3.fromRGB(80, 95, 115))

	resultBodyLabel = Instance.new("TextLabel")
	resultBodyLabel.Position = UDim2.new(0, 20, 0, 18)
	resultBodyLabel.Size = UDim2.new(1, -40, 1, -76)
