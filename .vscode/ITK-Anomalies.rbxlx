	resultFrame = Instance.new("Frame")
	resultFrame.Position = UDim2.new(0.5, -200, 0.5, -165)
	resultFrame.Size = UDim2.new(0, 400, 0, 330)
	resultFrame.BackgroundColor3 = Color3.fromRGB(20, 23, 28)
	resultFrame.BorderSizePixel = 0
