						<Item class="Script" referent="RBX8F5DDF75FFE648B5844CA2FE620E4AD1">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local doorOpen = script.Parent.open
local changingState = false
local sound = script.Parent.Hinge.door_open
local sound2 = script.Parent.Hinge.door_close

for i, v in pairs(script.Parent:GetChildren()) do
	if v:FindFirstChild("ClickDetector") then
		v.ClickDetector.MouseClick:Connect(function()
			if doorOpen.Value == true and changingState == false then
				changingState = true
				sound2:Play()
				for i = 1, 20 do
					script.Parent:SetPrimaryPartCFrame(script.Parent.PrimaryPart.CFrame * CFrame.Angles(0, math.rad(-5), 0))
					wait()
				end
				script.Parent.Parent.Parent.Button.Button.ClickDetector.MaxActivationDistance = 3.2
				
				changingState = false
				doorOpen.Value = false
			elseif changingState == false then
				changingState = true
				sound:Play()
				for i = 1, 20 do
					script.Parent:SetPrimaryPartCFrame(script.Parent.PrimaryPart.CFrame * CFrame.Angles(0, math.rad(5), 0))
					if i == 10 then
						end
					wait()
				end
				changingState = false
				doorOpen.Value = true
			end
		end)
	end
end]]></ProtectedString>
